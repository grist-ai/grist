# Copy to .env and fill in (`.env` is gitignored):
#   cp .env.example .env

# Client (any user — accounts are open)
# GRIST_GATEWAY_URL=https://grist-api.example.com
# GRIST_API_KEY=grist_sk_...            # from the dashboard's API keys tab

# Bring your own provider key (OpenRouter, Vercel AI Gateway, or any
# OpenAI-compatible endpoint). Inference is billed to this key.
# OPENROUTER_API_KEY=<redacted>

# Gateway process (operator only — never ship, never put in the npm tarball)
# TYPESAFE_API_KEY=<redacted>             # Jev confidence-gate key
# GRIST_MASTER_KEY=<redacted>             # house fallback when callers bring no key
# GRIST_ADMIN_TOKEN=<redacted>
# GRIST_ADMIN_EMAIL=founder@example.com
# GRIST_GATEWAY_DB=grist-gateway.sqlite
# GRIST_GLOBAL_BUDGET_USD=250
# FIREBASE_API_KEY=<redacted>
# FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=

# Client behavior
# GRIST_MODE=normal
# GRIST_MECH=auto

# Memory — Supermemory is MIT; Grist auto-manages the local sidecar:
#   bunx supermemory local install   # once
#   (Grist starts supermemory-server on first memory use)
# SUPERMEMORY_API_KEY=<redacted>
# SUPERMEMORY_BASE_URL=http://127.0.0.1:6767
# GRIST_MEMORY=file                  # force file store
# GRIST_MEMORY=off                   # disable
# GRIST_DEBUG=1                    # ctrl/usage logs to stderr (off = silent for TUI)
# GRIST_DEBUG=file                 # append to ~/.grist/debug.log
# GRIST_USAGE_LOG=off              # skip usage recording entirely

# Observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
