# Copy to .env and fill in (`.env` is gitignored):
#   cp .env.example .env
#
# Testers: do not set OPENROUTER_API_KEY. Use `grist init --invite`.
# Founder: these keys belong on the gateway process only.

# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# GRIST_MODE=normal
# GRIST_MECH=auto

# Memory — Supermemory is MIT; Grist auto-manages the local sidecar:
#   bunx supermemory local install   # once
#   (Grist starts supermemory-server on first memory use)
# SUPERMEMORY_API_KEY=sm_...         # optional on localhost
# SUPERMEMORY_BASE_URL=http://127.0.0.1:6767
# GRIST_MEMORY=file                  # force file store
# GRIST_MEMORY=off                   # disable
# GRIST_DEBUG=1                    # ctrl/usage logs to stderr (off = silent for TUI)
# GRIST_DEBUG=file                 # append to ~/.grist/debug.log
# GRIST_USAGE_LOG=off              # skip usage recording entirely

# Client (testers)
# GRIST_GATEWAY_URL=http://127.0.0.1:8787
# GRIST_INVITE=grist-XXXX-XXXX

# Gateway process (founder — never ship, never put in the npm tarball)
# OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=
# GRIST_ADMIN_TOKEN=
# GRIST_ADMIN_EMAIL=admin@grist.lol
# GRIST_GATEWAY_DB=grist-gateway.sqlite
# GRIST_GLOBAL_BUDGET_USD=250
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
