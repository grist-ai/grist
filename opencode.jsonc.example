{
  "$schema": "https://opencode.ai/config.json",
  // Phase 1 default: cheapest rung (DeepSeek Flash).
  // Copy to opencode.jsonc (gitignored) and set DEEPSEEK_API_KEY.
  "model": "deepseek/deepseek-flash",
  "provider": {
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash (cheapest)"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (medium)"
        }
      }
    }
  }
}
